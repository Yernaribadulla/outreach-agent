# LM Studio (local only)
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=qwen/qwen3-vl-8b

# Demo link and sender identity
DENTARA_DEMO_URL=
SENDER_NAME=
SENDER_BRAND=
SENDER_CONTACT=

# Real SMTP stays locked behind this explicit mode switch.
SIMULATED_SEND=true
# Legacy SMTP_ENABLED is read only when SIMULATED_SEND is unset.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USE_TLS=false
SMTP_USERNAME=yernaribadulla@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
SMTP_FROM=Yernar <yernaribadulla@gmail.com>
SMTP_MIN_DELAY_SECONDS=30
